# Copy this file to .env and fill in your Supabase credentials.
# You can find these in your Supabase dashboard → Project Settings → API.

# Your Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Your Supabase ANON key (the "anon public" one) — safe to use for inserts
# if your sessions table RLS allows it. For production-grade writes use the
# service_role key (but keep it secret and never commit .env).
SUPABASE_KEY=

# Optional: how often to flush position data to Supabase, in milliseconds.
# Default 5000 (5 seconds). Lower = more real-time but more writes.
FLUSH_INTERVAL_MS=5000

# Optional: enable debug logging (true/false)
DEBUG=false

# Optional: trigger an email to all subscribers when race ends.
# Get a key by setting NEWSLETTER_TRIGGER_KEY in Vercel env vars (any random string).
# Leave blank to disable email triggering from the bridge.
NEWSLETTER_TRIGGER_URL=https://f1-predictor-theta.vercel.app/api/send-newsletter
NEWSLETTER_TRIGGER_KEY=
