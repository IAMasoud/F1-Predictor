# Copy this file to .env and fill it in. Never commit .env.

# The website the bridge saves live timing to (via its /api/save endpoint).
SITE_URL=https://pitwall.company

# The CRON_SECRET value set in Vercel (Settings → Environment Variables).
# It lets the bridge save data and trigger the race-report email.
BRIDGE_KEY=

# Optional: how often to save positions, in milliseconds (default 5000).
FLUSH_INTERVAL_MS=5000

# Optional: enable debug logging (true/false)
DEBUG=false

# Optional: email all subscribers ~90s after the race ends. Leave the key blank to disable.
NEWSLETTER_TRIGGER_URL=https://pitwall.company/api/send-newsletter
NEWSLETTER_TRIGGER_KEY=
